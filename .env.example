# ─────────────────────────────────────────────────────────────────────────────
# Tesco Structures — Design CRM backend environment variables
# Copy this file to ".env" and fill in the real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Port the API server listens on (Coordinator=5000, Manager=5001, Head=5002,
# Purchase Manager=5003 — Design CRM uses 5006 to avoid clashing).
PORT=5006

# Node environment: development | production
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# SHARED with Procurement: set MONGO_URI to the EXACT SAME value the Purchase
# Manager / Sales Head backend uses (same cluster + database, e.g. .../salescrm).
# The Design CRM stores its data in its own design_* collections, so it lives
# safely alongside the purchase_* / sales collections in that same database.
# (MONGODB_URI is accepted as a fallback name.)
MONGO_URI=

# ── Authentication ──────────────────────────────────────────────────────────
# Use the SAME JWT_SECRET as the other Tesco CRMs so logins/tokens interoperate
# across them (single sign-on).
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins. Use * for any (dev only).
# Example: http://localhost:5173,https://design.tescomanagement.com
CORS_ORIGINS=*

# ── Uploads ─────────────────────────────────────────────────────────────────
# Max upload size in megabytes. Files are stored in MongoDB (one document per
# file), which caps a single document at 16 MB, so keep this comfortably under.
MAX_UPLOAD_MB=12

# ── First-run account seed (optional) ───────────────────────────────────────
# Used only by `npm run seed:admin` to create the first Design Head / Design Team
# logins in the shared database (own design_users collection) so you can sign in.
# Change these passwords and re-seed, or remove after first use.
SEED_HEAD_EMAIL=head@tesco.com
SEED_HEAD_PASSWORD=
SEED_HEAD_NAME=Design Head
SEED_TEAM_EMAIL=team@tesco.com
SEED_TEAM_PASSWORD=
SEED_TEAM_NAME=Design Team
